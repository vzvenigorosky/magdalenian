{
  "name": "magdalenian-observer",
  "version": "1.0.0",
  "description": "An interactive observer for a simulated year in the life of a Magdalenian hunter-gatherer band",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build:data",
    "dev": "vite",
    "prebuild": "npm run build:data",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:data": "tsx scripts/build-data.ts",
    "build:icons": "tsx scripts/make-icons.ts",
    "events": "tsx scripts/events.ts",
    "test": "vitest run",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource/forum": "^5.0.0",
    "@fontsource/sometype-mono": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.2",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0"
  }
}
